 Begin FrameSet 	# Set of inter-related coordinate systems
#   Title = "2-d coordinate system" 	# Title of coordinate system
#   Naxes = 2 	# Number of coordinate axes
#   Domain = "TOP" 	# Coordinate system domain
#   Lbl1 = "Axis 1" 	# Label for axis 1
#   Lbl2 = "Axis 2" 	# Label for axis 2
 IsA Frame 	# Coordinate system description
    Nframe = 3 	# Number of Frames in FrameSet
#   Base = 1 	# Index of base Frame
    Currnt = 3 	# Index of current Frame
    Lnk2 = 1 	# Node 2 is derived from node 1
    Lnk3 = 2 	# Node 3 is derived from node 2
    Frm1 = 	# Frame number 1
       Begin Frame 	# Coordinate system description
          Title = "pixel grid" 	# Title of coordinate system
          Naxes = 2 	# Number of coordinate axes
          Domain = "GRID" 	# Coordinate system domain
#         Lbl1 = "Axis 1" 	# Label for axis 1
#         Lbl2 = "Axis 2" 	# Label for axis 2
          Ax1 = 	# Axis number 1
             Begin Axis 	# Coordinate axis
             End Axis
          Ax2 = 	# Axis number 2
             Begin Axis 	# Coordinate axis
             End Axis
       End Frame
    Frm2 = 	# Frame number 2
       Begin Frame 	# Coordinate system description
#         Title = "2-d coordinate system" 	# Title of coordinate system
          Naxes = 2 	# Number of coordinate axes
          Domain = "MID" 	# Coordinate system domain
#         Lbl1 = "Axis 1" 	# Label for axis 1
#         Lbl2 = "Axis 2" 	# Label for axis 2
          Ax1 = 	# Axis number 1
             Begin Axis 	# Coordinate axis
             End Axis
          Ax2 = 	# Axis number 2
             Begin Axis 	# Coordinate axis
             End Axis
       End Frame
    Frm3 = 	# Frame number 3
       Begin Frame 	# Coordinate system description
#         Title = "2-d coordinate system" 	# Title of coordinate system
          Naxes = 2 	# Number of coordinate axes
          Domain = "TOP" 	# Coordinate system domain
#         Lbl1 = "Axis 1" 	# Label for axis 1
#         Lbl2 = "Axis 2" 	# Label for axis 2
          Ax1 = 	# Axis number 1
             Begin Axis 	# Coordinate axis
             End Axis
          Ax2 = 	# Axis number 2
             Begin Axis 	# Coordinate axis
             End Axis
       End Frame
    Map2 = 	# Mapping between nodes 1 and 2
       Begin ZoomMap 	# Zoom about the origin
          Nin = 2 	# Number of input coordinates
       IsA Mapping 	# Mapping between coordinate systems
          Zoom = 2 	# Zoom factor
       End ZoomMap
    Map3 = 	# Mapping between nodes 2 and 3
       Begin CmpFrame 	# Compound coordinate system description
#         Title = "2-d compound coordinate system" 	# Title of coordinate system
#         Naxes = 2 	# Number of coordinate axes
#         Domain = "A-B" 	# Coordinate system domain
#         Lbl1 = "Axis 1" 	# Label for axis 1
#         Lbl2 = "Axis 2" 	# Label for axis 2
       IsA Frame 	# Coordinate system description
          FrameA = 	# First component Frame
             Begin Frame 	# Coordinate system description
                Naxes = 1 	# Number of coordinate axes
                Domain = "A" 	# Coordinate system domain
                Ax1 = 	# Axis number 1
                   Begin Axis 	# Coordinate axis
                   End Axis
             End Frame
          FrameB = 	# Second component Frame
             Begin Frame 	# Coordinate system description
                Naxes = 1 	# Number of coordinate axes
                Domain = "B" 	# Coordinate system domain
                Ax1 = 	# Axis number 1
                   Begin Axis 	# Coordinate axis
                   End Axis
             End Frame
       End CmpFrame
 End FrameSet
