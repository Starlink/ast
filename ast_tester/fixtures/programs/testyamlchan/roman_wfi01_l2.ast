# The FrameSet a YamlChan reads from the GWCS of a Roman WFI01 Level 2
# calibrated image, r0000101001001001001_0001_wfi01_f158_cal.asdf (romancal
# Build 21).
#
# Sampling domain for gen_transform_oracle, one "lo hi" pair per input axis:
# the GWCS bounding box of the detector frame, i.e. the edges of the
# 4088x4088 science array in GWCS's 0-based pixel convention.
# oracle-bounds: -0.5 4087.5
# oracle-bounds: -0.5 4087.5
 Begin FrameSet 	# Set of inter-related coordinate systems
    ID = "FIT-LVL2-GAIADR3_S3" 	# Object identification string
 IsA Object 	# AST Object
#   Title = "ICRS coordinates" 	# Title of coordinate system
#   Naxes = 2 	# Number of coordinate axes
#   Domain = "SKY" 	# Coordinate system domain
#   Epoch = 2000 	# Julian epoch of observation
#   Lbl1 = "Right ascension" 	# Label for axis 1
#   Lbl2 = "Declination" 	# Label for axis 2
#   System = "ICRS" 	# Coordinate system type
#   Uni1 = "hh:mm:ss.s" 	# Units for axis 1
#   Uni2 = "ddd:mm:ss" 	# Units for axis 2
#   Dir1 = 0 	# Plot axis 1 in reverse direction
#   Bot2 = -1.5707963267948966 	# Lowest legal axis value
#   Top2 = 1.5707963267948966 	# Highest legal axis value
 IsA Frame 	# Coordinate system description
    Nframe = 5 	# Number of Frames in FrameSet
#   Base = 1 	# Index of base Frame
    Currnt = 5 	# Index of current Frame
    Lnk2 = 1 	# Node 2 is derived from node 1
    Lnk3 = 2 	# Node 3 is derived from node 2
    Lnk4 = 3 	# Node 4 is derived from node 3
    Lnk5 = 4 	# Node 5 is derived from node 4
    Frm1 = 	# Frame number 1
       Begin Frame 	# Coordinate system description
#         Title = "2-d coordinate system" 	# Title of coordinate system
          Naxes = 2 	# Number of coordinate axes
          Domain = "DETECTOR" 	# Coordinate system domain
#         Lbl1 = "custom:x" 	# Label for axis 1
#         Lbl2 = "custom:y" 	# Label for axis 2
#         Uni1 = "pixel" 	# Units for axis 1
#         Uni2 = "pixel" 	# Units for axis 2
          Ax1 = 	# Axis number 1
             Begin Axis 	# Coordinate axis
                Label = "custom:x" 	# Axis Label
                Symbol = "x" 	# Axis symbol
                Unit = "pixel" 	# Axis units
             End Axis
          Ax2 = 	# Axis number 2
             Begin Axis 	# Coordinate axis
                Label = "custom:y" 	# Axis Label
                Symbol = "y" 	# Axis symbol
                Unit = "pixel" 	# Axis units
             End Axis
       End Frame
    Frm2 = 	# Frame number 2
       Begin Frame 	# Coordinate system description
#         Title = "2-d coordinate system" 	# Title of coordinate system
          Naxes = 2 	# Number of coordinate axes
          Domain = "V2V3" 	# Coordinate system domain
#         Lbl1 = "custom:v2" 	# Label for axis 1
#         Lbl2 = "custom:v3" 	# Label for axis 2
#         Uni1 = "arcsec" 	# Units for axis 1 (arc-second)
#         Uni2 = "arcsec" 	# Units for axis 2 (arc-second)
          Ax1 = 	# Axis number 1
             Begin Axis 	# Coordinate axis
                Label = "custom:v2" 	# Axis Label
                Symbol = "v2" 	# Axis symbol
                Unit = "arcsec" 	# Axis units (arc-second)
             End Axis
          Ax2 = 	# Axis number 2
             Begin Axis 	# Coordinate axis
                Label = "custom:v3" 	# Axis Label
                Symbol = "v3" 	# Axis symbol
                Unit = "arcsec" 	# Axis units (arc-second)
             End Axis
       End Frame
    Frm3 = 	# Frame number 3
       Begin Frame 	# Coordinate system description
#         Title = "2-d coordinate system" 	# Title of coordinate system
          Naxes = 2 	# Number of coordinate axes
          Domain = "V2V3VACORR" 	# Coordinate system domain
#         Lbl1 = "custom:v2" 	# Label for axis 1
#         Lbl2 = "custom:v3" 	# Label for axis 2
#         Uni1 = "arcsec" 	# Units for axis 1 (arc-second)
#         Uni2 = "arcsec" 	# Units for axis 2 (arc-second)
          Ax1 = 	# Axis number 1
             Begin Axis 	# Coordinate axis
                Label = "custom:v2" 	# Axis Label
                Symbol = "v2" 	# Axis symbol
                Unit = "arcsec" 	# Axis units (arc-second)
             End Axis
          Ax2 = 	# Axis number 2
             Begin Axis 	# Coordinate axis
                Label = "custom:v3" 	# Axis Label
                Symbol = "v3" 	# Axis symbol
                Unit = "arcsec" 	# Axis units (arc-second)
             End Axis
       End Frame
    Frm4 = 	# Frame number 4
       Begin Frame 	# Coordinate system description
#         Title = "2-d coordinate system" 	# Title of coordinate system
          Naxes = 2 	# Number of coordinate axes
          Domain = "V2V3CORR" 	# Coordinate system domain
#         Lbl1 = "custom:v2" 	# Label for axis 1
#         Lbl2 = "custom:v3" 	# Label for axis 2
#         Uni1 = "arcsec" 	# Units for axis 1 (arc-second)
#         Uni2 = "arcsec" 	# Units for axis 2 (arc-second)
          Ax1 = 	# Axis number 1
             Begin Axis 	# Coordinate axis
                Label = "custom:v2" 	# Axis Label
                Symbol = "v2" 	# Axis symbol
                Unit = "arcsec" 	# Axis units (arc-second)
             End Axis
          Ax2 = 	# Axis number 2
             Begin Axis 	# Coordinate axis
                Label = "custom:v3" 	# Axis Label
                Symbol = "v3" 	# Axis symbol
                Unit = "arcsec" 	# Axis units (arc-second)
             End Axis
       End Frame
    Frm5 = 	# Frame number 5
       Begin SkyFrame 	# Description of celestial coordinate system
#         Title = "ICRS coordinates" 	# Title of coordinate system
          Naxes = 2 	# Number of coordinate axes
#         Domain = "SKY" 	# Coordinate system domain
#         Epoch = 2000 	# Julian epoch of observation
#         Lbl1 = "Right ascension" 	# Label for axis 1
#         Lbl2 = "Declination" 	# Label for axis 2
          System = "ICRS" 	# Coordinate system type
#         Uni1 = "hh:mm:ss.s" 	# Units for axis 1
#         Uni2 = "ddd:mm:ss" 	# Units for axis 2
#         Dir1 = 0 	# Plot axis 1 in reverse direction
#         Bot2 = -1.5707963267948966 	# Lowest legal axis value
#         Top2 = 1.5707963267948966 	# Highest legal axis value
          Ax1 = 	# Axis number 1
             Begin SkyAxis 	# Celestial coordinate axis
             End SkyAxis
          Ax2 = 	# Axis number 2
             Begin SkyAxis 	# Celestial coordinate axis
             End SkyAxis
       IsA Frame 	# Coordinate system description
#         SkyTol = 0.001 	# Smallest significant separation [arc-sec]
       End SkyFrame
    Map2 = 	# Mapping between nodes 1 and 2
       Begin CmpMap 	# Compound Mapping
          Nin = 2 	# Number of input coordinates
       IsA Mapping 	# Mapping between coordinate systems
          MapA = 	# First component Mapping
             Begin CmpMap 	# Compound Mapping
                Nin = 2 	# Number of input coordinates
             IsA Mapping 	# Mapping between coordinate systems
                MapA = 	# First component Mapping
                   Begin CmpMap 	# Compound Mapping
                      Nin = 2 	# Number of input coordinates
                   IsA Mapping 	# Mapping between coordinate systems
                      MapA = 	# First component Mapping
                         Begin ShiftMap 	# Shift each coordinate axis
                            Nin = 2 	# Number of input coordinates
                            IsSimp = 1 	# Mapping has been simplified
                         IsA Mapping 	# Mapping between coordinate systems
                            Sft1 = 1 	# Shift for axis 1
                            Sft2 = 1 	# Shift for axis 2
                         End ShiftMap
                      MapB = 	# Second component Mapping
                         Begin ShiftMap 	# Shift each coordinate axis
                            Nin = 2 	# Number of input coordinates
                            IsSimp = 1 	# Mapping has been simplified
                         IsA Mapping 	# Mapping between coordinate systems
                            Sft1 = -2044.5 	# Shift for axis 1
                            Sft2 = -2044.5 	# Shift for axis 2
                         End ShiftMap
                   End CmpMap
                MapB = 	# Second component Mapping
                   Begin CmpMap 	# Compound Mapping
                      Nin = 2 	# Number of input coordinates
                   IsA Mapping 	# Mapping between coordinate systems
                      MapA = 	# First component Mapping
                         Begin PolyMap 	# Polynomial transformation
                            Nin = 2 	# Number of input coordinates
