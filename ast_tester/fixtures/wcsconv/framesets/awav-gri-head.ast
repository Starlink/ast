 Begin FrameSet 	# Set of inter-related coordinate systems
#   Title = "Wavelength in air" 	# Title of coordinate system
#   Naxes = 1 	# Number of coordinate axes
#   Domain = "SPECTRUM" 	# Coordinate system domain
#   Epoch = 2000 	# Julian epoch of observation
#   Lbl1 = "Wavelength in air" 	# Label for axis 1
#   System = "AWAV" 	# Coordinate system type
#   Uni1 = "Angstrom" 	# Units for axis 1
 IsA Frame 	# Coordinate system description
    Nframe = 2 	# Number of Frames in FrameSet
    Base = 1 	# Index of base Frame
    Currnt = 2 	# Index of current Frame
    Lnk2 = 1 	# Node 2 is derived from node 1
    Frm1 = 	# Frame number 1
       Begin Frame 	# Coordinate system description
          Title = "Pixel Coordinates" 	# Title of coordinate system
          Naxes = 1 	# Number of coordinate axes
          Domain = "GRID" 	# Coordinate system domain
#         Lbl1 = "Pixel axis 1" 	# Label for axis 1
          Ax1 = 	# Axis number 1
             Begin Axis 	# Coordinate axis
                Label = "Pixel axis 1" 	# Axis Label
             End Axis
       End Frame
    Frm2 = 	# Frame number 2
       Begin SpecFrame 	# Description of spectral coordinate system
          Ident = " " 	# Permanent Object identification string
       IsA Object 	# AST Object
#         Title = "Wavelength in air" 	# Title of coordinate system
          Naxes = 1 	# Number of coordinate axes
#         Domain = "SPECTRUM" 	# Coordinate system domain
#         Epoch = 2000 	# Julian epoch of observation
#         Lbl1 = "Wavelength in air" 	# Label for axis 1
          System = "AWAV" 	# Coordinate system type
#         Uni1 = "Angstrom" 	# Units for axis 1
          Ax1 = 	# Axis number 1
             Begin Axis 	# Coordinate axis
                Unit = "Angstrom" 	# Axis units
             End Axis
       IsA Frame 	# Coordinate system description
#         SoR = "Heliocentric" 	# Standard of rest
          UAwav = "Angstrom" 	# Preferred units for wavelength in air
       End SpecFrame
    Map2 = 	# Mapping between nodes 1 and 2
       Begin CmpMap 	# Compound Mapping
          Nin = 1 	# Number of input coordinates
          IsSimp = 1 	# Mapping has been simplified
       IsA Mapping 	# Mapping between coordinate systems
          MapA = 	# First component Mapping
             Begin WinMap 	# Map one window on to another
                Nin = 1 	# Number of input coordinates
             IsA Mapping 	# Mapping between coordinate systems
                Sft1 = -0.31643158989760578 	# Shift for axis 1
                Scl1 = 0.00031806463791564572 	# Scale factor for axis 1
             End WinMap
          MapB = 	# Second component Mapping
             Begin CmpMap 	# Compound Mapping
                Nin = 1 	# Number of input coordinates
             IsA Mapping 	# Mapping between coordinate systems
                MapA = 	# First component Mapping
                   Begin GrismMap 	# Map 1-d coordinates using a spectral disperser
                      Nin = 1 	# Number of input coordinates
                      Invert = 1 	# Mapping inverted
                   IsA Mapping 	# Mapping between coordinate systems
                      GrmNR = 1.7649999999999999 	# Refractive index at the ref. wavelength
                      GrmNRP = -1077000 	# Rate of change of refractive index
                      GrmWR = 7.2473066714696677e-07 	# Ref. wavelength
                      GrmAlp = 0.47123889803846897 	# Angle of incidence of incoming light
                      GrmG = 450000 	# Grating ruling density
                      GrmM = 1 	# The interference order
                      GrmEps = 0.05235987755982989 	# Angle between grating normal and dispersion plane
                      GrmTh = 0.087266462599716474 	# Angle between detector normal and reference ray
                   End GrismMap
                MapB = 	# Second component Mapping
                   Begin CmpMap 	# Compound Mapping
                      Nin = 1 	# Number of input coordinates
                   IsA Mapping 	# Mapping between coordinate systems
                      MapA = 	# First component Mapping
                         Begin SpecMap 	# Conversion between spectral coordinate systems
                            Nin = 1 	# Number of input coordinates
                         IsA Mapping 	# Mapping between coordinate systems
                            Nspec = 2 	# Number of conversion steps
                            Spec1 = "WVTOFR" 	# Convert wavelength (vacuum) to frequency
                            Spec2 = "FRTOAW" 	# Convert frequency to wavelength (air)
                         End SpecMap
                      MapB = 	# Second component Mapping
                         Begin ZoomMap 	# Zoom about the origin
                            Nin = 1 	# Number of input coordinates
                         IsA Mapping 	# Mapping between coordinate systems
                            Zoom = 10000000000 	# Zoom factor
                         End ZoomMap
                   End CmpMap
             End CmpMap
       End CmpMap
 End FrameSet
