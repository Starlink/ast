 Begin FrameSet 	# Set of inter-related coordinate systems
#   Title = "IAU (1958) galactic coordinates; gnomonic projection" 	# Title of coordinate system
#   Naxes = 2 	# Number of coordinate axes
#   Domain = "SKY" 	# Coordinate system domain
#   Epoch = 2000 	# Julian epoch of observation
#   Lbl1 = "Galactic longitude" 	# Label for axis 1
#   Lbl2 = "Galactic latitude" 	# Label for axis 2
#   System = "GALACTIC" 	# Coordinate system type
#   Uni1 = "degrees" 	# Units for axis 1
#   Uni2 = "degrees" 	# Units for axis 2
#   Dir1 = 0 	# Plot axis 1 in reverse direction
#   Bot2 = -1.5707963267948966 	# Lowest legal axis value
#   Top2 = 1.5707963267948966 	# Highest legal axis value
 IsA Frame 	# Coordinate system description
    Nframe = 4 	# Number of Frames in FrameSet
    Base = 1 	# Index of base Frame
    Currnt = 2 	# Index of current Frame
    Lnk2 = 1 	# Node 2 is derived from node 1
    Lnk3 = 1 	# Node 3 is derived from node 1
    Lnk4 = 1 	# Node 4 is derived from node 1
    Frm1 = 	# Frame number 1
       Begin Frame 	# Coordinate system description
          Title = "Pixel Coordinates" 	# Title of coordinate system
          Naxes = 2 	# Number of coordinate axes
          Domain = "GRID" 	# Coordinate system domain
#         Lbl1 = "Pixel axis 1" 	# Label for axis 1
#         Lbl2 = "Pixel axis 2" 	# Label for axis 2
          Ax1 = 	# Axis number 1
             Begin Axis 	# Coordinate axis
                Label = "Pixel axis 1" 	# Axis Label
             End Axis
          Ax2 = 	# Axis number 2
             Begin Axis 	# Coordinate axis
                Label = "Pixel axis 2" 	# Axis Label
             End Axis
       End Frame
    Frm2 = 	# Frame number 2
       Begin SkyFrame 	# Description of celestial coordinate system
          Ident = " " 	# Permanent Object identification string
       IsA Object 	# AST Object
#         Title = "IAU (1958) galactic coordinates; gnomonic projection" 	# Title of coordinate system
          Naxes = 2 	# Number of coordinate axes
#         Domain = "SKY" 	# Coordinate system domain
          Epoch = 2000 	# Julian epoch of observation
#         Lbl1 = "Galactic longitude" 	# Label for axis 1
#         Lbl2 = "Galactic latitude" 	# Label for axis 2
          System = "GALACTIC" 	# Coordinate system type
#         Uni1 = "degrees" 	# Units for axis 1
#         Uni2 = "degrees" 	# Units for axis 2
#         Dir1 = 0 	# Plot axis 1 in reverse direction
#         Bot2 = -1.5707963267948966 	# Lowest legal axis value
#         Top2 = 1.5707963267948966 	# Highest legal axis value
          Ax1 = 	# Axis number 1
             Begin SkyAxis 	# Celestial coordinate axis
             End SkyAxis
          Ax2 = 	# Axis number 2
             Begin SkyAxis 	# Celestial coordinate axis
             End SkyAxis
       IsA Frame 	# Coordinate system description
          Proj = "gnomonic" 	# Description of sky projection
#         SkyTol = 0.001 	# Smallest significant separation [arc-sec]
          SRefIs = "Ignored" 	# Not rotated (ref. pos. is ignored)
          SRef1 = 3.1415926535897931 	# Ref. pos. l 180.0000
          SRef2 = 0 	# Ref. pos. b 0.0000
       End SkyFrame
    Frm3 = 	# Frame number 3
       Begin SkyFrame 	# Description of celestial coordinate system
          Ident = "A" 	# Permanent Object identification string
       IsA Object 	# AST Object
#         Title = "ICRS coordinates; gnomonic projection" 	# Title of coordinate system
          Naxes = 2 	# Number of coordinate axes
#         Domain = "SKY" 	# Coordinate system domain
#         Epoch = 2000 	# Julian epoch of observation
#         Lbl1 = "Right ascension" 	# Label for axis 1
#         Lbl2 = "Declination" 	# Label for axis 2
          System = "ICRS" 	# Coordinate system type
#         Uni1 = "hh:mm:ss.s" 	# Units for axis 1
#         Uni2 = "ddd:mm:ss" 	# Units for axis 2
#         Dir1 = 0 	# Plot axis 1 in reverse direction
#         Bot2 = -1.5707963267948966 	# Lowest legal axis value
#         Top2 = 1.5707963267948966 	# Highest legal axis value
          Ax1 = 	# Axis number 1
             Begin SkyAxis 	# Celestial coordinate axis
             End SkyAxis
          Ax2 = 	# Axis number 2
             Begin SkyAxis 	# Celestial coordinate axis
             End SkyAxis
       IsA Frame 	# Coordinate system description
          Proj = "gnomonic" 	# Description of sky projection
#         SkyTol = 0.001 	# Smallest significant separation [arc-sec]
          SRefIs = "Ignored" 	# Not rotated (ref. pos. is ignored)
          SRef1 = 4.6496443937754934 	# Ref. pos. RA 17:45:37.2
          SRef2 = -0.50502847235707915 	# Ref. pos. Dec -28:56:10
       End SkyFrame
    Frm4 = 	# Frame number 4
       Begin SkyFrame 	# Description of celestial coordinate system
          Ident = "B" 	# Permanent Object identification string
       IsA Object 	# AST Object
#         Title = "Ecliptic coordinates; mean equinox J2000.0; gnomonic projection" 	# Title of coordinate system
          Naxes = 2 	# Number of coordinate axes
#         Domain = "SKY" 	# Coordinate system domain
#         Epoch = 2000 	# Julian epoch of observation
#         Lbl1 = "Ecliptic longitude" 	# Label for axis 1
#         Lbl2 = "Ecliptic latitude" 	# Label for axis 2
          System = "ECLIPTIC" 	# Coordinate system type
#         Uni1 = "degrees" 	# Units for axis 1
#         Uni2 = "degrees" 	# Units for axis 2
#         Dir1 = 0 	# Plot axis 1 in reverse direction
#         Bot2 = -1.5707963267948966 	# Lowest legal axis value
#         Top2 = 1.5707963267948966 	# Highest legal axis value
          Ax1 = 	# Axis number 1
             Begin SkyAxis 	# Celestial coordinate axis
             End SkyAxis
          Ax2 = 	# Axis number 2
             Begin SkyAxis 	# Celestial coordinate axis
             End SkyAxis
       IsA Frame 	# Coordinate system description
          Proj = "gnomonic" 	# Description of sky projection
#         SkyTol = 0.001 	# Smallest significant separation [arc-sec]
#         Eqnox = 2000 	# Julian epoch of mean equinox
          SRefIs = "Ignored" 	# Not rotated (ref. pos. is ignored)
          SRef1 = 4.7113243295409735 	# Ref. pos. Lambda 269.9390
          SRef2 = -0.09656906751284626 	# Ref. pos. Beta -5.5330
       End SkyFrame
    Map2 = 	# Mapping between nodes 1 and 2
       Begin CmpMap 	# Compound Mapping
          Nin = 2 	# Number of input coordinates
          IsSimp = 1 	# Mapping has been simplified
       IsA Mapping 	# Mapping between coordinate systems
          MapA = 	# First component Mapping
             Begin WinMap 	# Map one window on to another
                Nin = 2 	# Number of input coordinates
             IsA Mapping 	# Mapping between coordinate systems
                Sft1 = 0.026267205242514663 	# Shift for axis 1
                Scl1 = -0.00017453292519943296 	# Scale factor for axis 1
                Sft2 = -0.026267205242514663 	# Shift for axis 2
                Scl2 = 0.00017453292519943296 	# Scale factor for axis 2
             End WinMap
          MapB = 	# Second component Mapping
             Begin CmpMap 	# Compound Mapping
                Nin = 2 	# Number of input coordinates
             IsA Mapping 	# Mapping between coordinate systems
                InvA = 1 	# First Mapping used in inverse direction
                MapA = 	# First component Mapping
                   Begin WcsMap 	# FITS-WCS sky projection
                      Nin = 2 	# Number of input coordinates
                      Invert = 1 	# Mapping inverted
                   IsA Mapping 	# Mapping between coordinate systems
                      Type = "TAN" 	# Gnomonic projection
                   End WcsMap
                MapB = 	# Second component Mapping
                   Begin CmpMap 	# Compound Mapping
                      Nin = 2 	# Number of input coordinates
                   IsA Mapping 	# Mapping between coordinate systems
                      InvA = 1 	# First Mapping used in inverse direction
                      MapA = 	# First component Mapping
                         Begin SphMap 	# Cartesian to Spherical mapping
                            Nin = 3 	# Number of input coordinates
                            Nout = 2 	# Number of output coordinates
                            Invert = 1 	# Mapping inverted
                         IsA Mapping 	# Mapping between coordinate systems
                            UntRd = 1 	# All input vectors have unit length
                            PlrLg = 0 	# Polar longitude (rad.s)
                         End SphMap
                      MapB = 	# Second component Mapping
                         Begin CmpMap 	# Compound Mapping
                            Nin = 3 	# Number of input coordinates
                            Nout = 2 	# Number of output coordinates
                         IsA Mapping 	# Mapping between coordinate systems
                            MapA = 	# First component Mapping
                               Begin MatrixMap 	# Matrix transformation
                                  Nin = 3 	# Number of input coordinates
                               IsA Mapping 	# Mapping between coordinate systems
                                  M0 = -6.123233995736766e-17 	# Forward matrix value
                                  M1 = 0 	# Forward matrix value
                                  M2 = -1 	# Forward matrix value
                                  M3 = 0 	# Forward matrix value
                                  M4 = -1 	# Forward matrix value
                                  M5 = 0 	# Forward matrix value
                                  M6 = -1 	# Forward matrix value
                                  M7 = 0 	# Forward matrix value
                                  M8 = 6.123233995736766e-17 	# Forward matrix value
                                  IM0 = -6.123233995736766e-17 	# Inverse matrix value
                                  IM1 = 0 	# Inverse matrix value
                                  IM2 = -1 	# Inverse matrix value
                                  IM3 = 0 	# Inverse matrix value
                                  IM4 = -1 	# Inverse matrix value
                                  IM5 = 0 	# Inverse matrix value
                                  IM6 = -1 	# Inverse matrix value
                                  IM7 = 0 	# Inverse matrix value
                                  IM8 = 6.123233995736766e-17 	# Inverse matrix value
                                  Form = "Full" 	# Matrix storage form
                               End MatrixMap
                            MapB = 	# Second component Mapping
                               Begin SphMap 	# Cartesian to Spherical mapping
                                  Nin = 3 	# Number of input coordinates
                                  Nout = 2 	# Number of output coordinates
                               IsA Mapping 	# Mapping between coordinate systems
                                  UntRd = 1 	# All input vectors have unit length
                                  PlrLg = 3.1415926535897931 	# Polar longitude (rad.s)
                               End SphMap
                         End CmpMap
                   End CmpMap
             End CmpMap
       End CmpMap
    Map3 = 	# Mapping between nodes 1 and 3
       Begin CmpMap 	# Compound Mapping
          Nin = 2 	# Number of input coordinates
          IsSimp = 1 	# Mapping has been simplified
       IsA Mapping 	# Mapping between coordinate systems
          MapA = 	# First component Mapping
             Begin WinMap 	# Map one window on to another
                Nin = 2 	# Number of input coordinates
             IsA Mapping 	# Mapping between coordinate systems
                Sft1 = 0.026267205242514663 	# Shift for axis 1
                Scl1 = -0.00017453292519943296 	# Scale factor for axis 1
                Sft2 = -0.026267205242514663 	# Shift for axis 2
                Scl2 = 0.00017453292519943296 	# Scale factor for axis 2
             End WinMap
          MapB = 	# Second component Mapping
             Begin CmpMap 	# Compound Mapping
                Nin = 2 	# Number of input coordinates
             IsA Mapping 	# Mapping between coordinate systems
                InvA = 1 	# First Mapping used in inverse direction
                MapA = 	# First component Mapping
                   Begin WcsMap 	# FITS-WCS sky projection
                      Nin = 2 	# Number of input coordinates
                      Invert = 1 	# Mapping inverted
                   IsA Mapping 	# Mapping between coordinate systems
                      Type = "TAN" 	# Gnomonic projection
                   End WcsMap
                MapB = 	# Second component Mapping
                   Begin CmpMap 	# Compound Mapping
                      Nin = 2 	# Number of input coordinates
                   IsA Mapping 	# Mapping between coordinate systems
                      InvA = 1 	# First Mapping used in inverse direction
                      MapA = 	# First component Mapping
                         Begin SphMap 	# Cartesian to Spherical mapping
                            Nin = 3 	# Number of input coordinates
                            Nout = 2 	# Number of output coordinates
                            Invert = 1 	# Mapping inverted
                         IsA Mapping 	# Mapping between coordinate systems
                            UntRd = 1 	# All input vectors have unit length
                            PlrLg = 0 	# Polar longitude (rad.s)
                         End SphMap
                      MapB = 	# Second component Mapping
                         Begin CmpMap 	# Compound Mapping
                            Nin = 3 	# Number of input coordinates
                            Nout = 2 	# Number of output coordinates
                         IsA Mapping 	# Mapping between coordinate systems
                            MapA = 	# First component Mapping
                               Begin MatrixMap 	# Matrix transformation
                                  Nin = 3 	# Number of input coordinates
                               IsA Mapping 	# Mapping between coordinate systems
                                  M0 = 0.030337946011636297 	# Forward matrix value
                                  M1 = 0.9980322041345846 	# Forward matrix value
                                  M2 = -0.054875573273159117 	# Forward matrix value
                                  M3 = 0.48288027509356429 	# Forward matrix value
                                  M4 = -0.062703425028165838 	# Forward matrix value
                                  M5 = -0.87343856132832887 	# Forward matrix value
                                  M6 = -0.87516069893326376 	# Forward matrix value
                                  M7 = 0 	# Forward matrix value
                                  M8 = -0.48383235840799371 	# Forward matrix value
                                  IM0 = 0.030337946011636297 	# Inverse matrix value
                                  IM1 = 0.48288027509356429 	# Inverse matrix value
                                  IM2 = -0.87516069893326376 	# Inverse matrix value
                                  IM3 = 0.9980322041345846 	# Inverse matrix value
                                  IM4 = -0.062703425028165838 	# Inverse matrix value
                                  IM5 = 0 	# Inverse matrix value
                                  IM6 = -0.054875573273159117 	# Inverse matrix value
                                  IM7 = -0.87343856132832887 	# Inverse matrix value
                                  IM8 = -0.48383235840799371 	# Inverse matrix value
                                  Form = "Full" 	# Matrix storage form
                               End MatrixMap
                            MapB = 	# Second component Mapping
                               Begin SphMap 	# Cartesian to Spherical mapping
                                  Nin = 3 	# Number of input coordinates
                                  Nout = 2 	# Number of output coordinates
                               IsA Mapping 	# Mapping between coordinate systems
                                  UntRd = 1 	# All input vectors have unit length
                                  PlrLg = 4.6496443937754934 	# Polar longitude (rad.s)
                               End SphMap
                         End CmpMap
                   End CmpMap
             End CmpMap
       End CmpMap
    Map4 = 	# Mapping between nodes 1 and 4
       Begin CmpMap 	# Compound Mapping
          Nin = 2 	# Number of input coordinates
          IsSimp = 1 	# Mapping has been simplified
       IsA Mapping 	# Mapping between coordinate systems
          MapA = 	# First component Mapping
             Begin WinMap 	# Map one window on to another
                Nin = 2 	# Number of input coordinates
             IsA Mapping 	# Mapping between coordinate systems
                Sft1 = 0.026267205242514663 	# Shift for axis 1
                Scl1 = -0.00017453292519943296 	# Scale factor for axis 1
                Sft2 = -0.026267205242514663 	# Shift for axis 2
                Scl2 = 0.00017453292519943296 	# Scale factor for axis 2
             End WinMap
          MapB = 	# Second component Mapping
             Begin CmpMap 	# Compound Mapping
                Nin = 2 	# Number of input coordinates
             IsA Mapping 	# Mapping between coordinate systems
                InvA = 1 	# First Mapping used in inverse direction
                MapA = 	# First component Mapping
                   Begin WcsMap 	# FITS-WCS sky projection
                      Nin = 2 	# Number of input coordinates
                      Invert = 1 	# Mapping inverted
                   IsA Mapping 	# Mapping between coordinate systems
                      Type = "TAN" 	# Gnomonic projection
                   End WcsMap
                MapB = 	# Second component Mapping
                   Begin CmpMap 	# Compound Mapping
                      Nin = 2 	# Number of input coordinates
                   IsA Mapping 	# Mapping between coordinate systems
                      InvA = 1 	# First Mapping used in inverse direction
                      MapA = 	# First component Mapping
                         Begin SphMap 	# Cartesian to Spherical mapping
                            Nin = 3 	# Number of input coordinates
                            Nout = 2 	# Number of output coordinates
                            Invert = 1 	# Mapping inverted
                         IsA Mapping 	# Mapping between coordinate systems
                            UntRd = 1 	# All input vectors have unit length
                            PlrLg = 0 	# Polar longitude (rad.s)
                         End SphMap
                      MapB = 	# Second component Mapping
                         Begin CmpMap 	# Compound Mapping
                            Nin = 3 	# Number of input coordinates
                            Nout = 2 	# Number of output coordinates
                         IsA Mapping 	# Mapping between coordinate systems
                            MapA = 	# First component Mapping
                               Begin MatrixMap 	# Matrix transformation
                                  Nin = 3 	# Number of input coordinates
                               IsA Mapping 	# Mapping between coordinate systems
                                  M0 = 0.0001026525967744325 	# Forward matrix value
                                  M1 = 0.99999943325934404 	# Forward matrix value
                                  M2 = -0.0010596902543393396 	# Forward matrix value
                                  M3 = 0.096418989000328012 	# Forward matrix value
                                  M4 = -0.0010646506425895344 	# Forward matrix value
                                  M5 = -0.99534026597900871 	# Forward matrix value
                                  M6 = -0.99534083007912366 	# Forward matrix value
                                  M7 = 0 	# Forward matrix value
                                  M8 = -0.096419043644920058 	# Forward matrix value
                                  IM0 = 0.0001026525967744325 	# Inverse matrix value
                                  IM1 = 0.096418989000328012 	# Inverse matrix value
                                  IM2 = -0.99534083007912366 	# Inverse matrix value
                                  IM3 = 0.99999943325934404 	# Inverse matrix value
                                  IM4 = -0.0010646506425895344 	# Inverse matrix value
                                  IM5 = 0 	# Inverse matrix value
                                  IM6 = -0.0010596902543393396 	# Inverse matrix value
                                  IM7 = -0.99534026597900871 	# Inverse matrix value
                                  IM8 = -0.096419043644920058 	# Inverse matrix value
                                  Form = "Full" 	# Matrix storage form
                               End MatrixMap
                            MapB = 	# Second component Mapping
                               Begin SphMap 	# Cartesian to Spherical mapping
                                  Nin = 3 	# Number of input coordinates
                                  Nout = 2 	# Number of output coordinates
                               IsA Mapping 	# Mapping between coordinate systems
                                  UntRd = 1 	# All input vectors have unit length
                                  PlrLg = 4.7113243295409735 	# Polar longitude (rad.s)
                               End SphMap
                         End CmpMap
                   End CmpMap
             End CmpMap
       End CmpMap
 End FrameSet
