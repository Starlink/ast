 Begin MatrixMap 	# Matrix transformation
    Nin = 2 	# Number of input coordinates
    IsSimp = 1 	# Mapping has been simplified
 IsA Mapping 	# Mapping between coordinate systems
    M0 = 6 	# Forward matrix value
    M1 = 3 	# Forward matrix value
    M2 = -3 	# Forward matrix value
    M3 = 9 	# Forward matrix value
    IM0 = 0.14285714285714285 	# Inverse matrix value
    IM1 = -0.047619047619047616 	# Inverse matrix value
    IM2 = 0.047619047619047616 	# Inverse matrix value
    IM3 = 0.095238095238095233 	# Inverse matrix value
    Form = "Full" 	# Matrix storage form
 End MatrixMap
