    M2 = -2.2999999999999998 	# Forward matrix value
    M3 = 6.8999999999999995 	# Forward matrix value
    IM0 = 0.18633540372670809 	# Inverse matrix value
    IM1 = -0.062111801242236024 	# Inverse matrix value
    IM2 = 0.062111801242236024 	# Inverse matrix value
    IM3 = 0.12422360248447205 	# Inverse matrix value
    Form = "Full" 	# Matrix storage form
 End MatrixMap
