\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{ast}[2026/08/31 AST additions to the Starlink classes]

%  AST's addlinks script rewrites every cross-reference in the generated
%  .tex into \htmlref{text}{label}, but \htmlref is only ever defined in
%  starstyle.4ht, which tex4ht loads for the hypertext build. The pdflatex
%  path therefore had nothing to define it, and each reference raised an
%  undefined-control-sequence error -- thousands of them, leaving pdflatex
%  to exit non-zero while still emitting a usable PDF.
%
%  Render the text and discard the label rather than calling \hyperref:
%  addlinks passes the visible text as the label too (its label-mangling
%  line is commented out), and the \sstlabel call that would have defined
%  those labels is commented out as well, so there is no \label to point
%  at and \hyperref would only trade the errors for as many warnings.
%
%  \providecommand, not \newcommand: starstyle.4ht overrides \htmlref with
%  \renewcommand, which needs the command to exist first, so defining it
%  here serves the hypertext build too.
\providecommand{\htmlref}[2]{#1}

%  \htmladdnormallink and its footnote variant are LaTeX2HTML macros from
%  html.sty, which nothing in the Starlink support files loads -- yet
%  sun_master.tex uses all three of them and starabbrev.sty's \FITSref is
%  written in terms of the first, so they have been undefined in every build,
%  hypertext included.
%
%  html.sty renders them for print, dropping the URL entirely from the plain
%  form.  These are PDFs and starlink.cls loads hyperref, so make them real
%  links instead, and keep the footnote variant's promise of putting the URL
%  where a reader of paper can still see it.
\providecommand{\htmladdnormallink}[2]{\href{#2}{#1}}
\providecommand{\htmladdnormallinkfoot}[2]{\href{#2}{#1}\footnote{\url{#2}}}

\endinput
